{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "KILN_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "win-msvc-debug",
            "displayName": "Windows / MSVC / Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-msvc-release",
            "displayName": "Windows / MSVC / Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-clangcl-debug",
            "displayName": "Windows / clang-cl / Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-clangcl-release",
            "displayName": "Windows / clang-cl / Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux / clang / Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux / clang / Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux / gcc / Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux / gcc / Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mac-appleclang-debug",
            "displayName": "macOS / AppleClang / Debug (post-v0.5)",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-msvc-shipping",
            "displayName": "Windows / MSVC / Shipping (read-only runtime)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "KILN_BUILD_COOK": "OFF",
                "KILN_HOT_RELOAD": "OFF",
                "KILN_BUILD_TOOLS": "OFF",
                "KILN_BUILD_TESTS": "ON",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl"
            }
        },
        {
            "name": "win-clangcl-shipping",
            "displayName": "Windows / clang-cl / Shipping (read-only runtime)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "KILN_BUILD_COOK": "OFF",
                "KILN_HOT_RELOAD": "OFF",
                "KILN_BUILD_TOOLS": "OFF",
                "KILN_BUILD_TESTS": "ON",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_COMPILER": "clang-cl"
            }
        },
        {
            "name": "linux-clang-shipping",
            "displayName": "Linux / clang / Shipping (read-only runtime)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "KILN_BUILD_COOK": "OFF",
                "KILN_HOT_RELOAD": "OFF",
                "KILN_BUILD_TOOLS": "OFF",
                "KILN_BUILD_TESTS": "ON",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "linux-gcc-shipping",
            "displayName": "Linux / gcc / Shipping (read-only runtime)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "KILN_BUILD_COOK": "OFF",
                "KILN_HOT_RELOAD": "OFF",
                "KILN_BUILD_TOOLS": "OFF",
                "KILN_BUILD_TESTS": "ON",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-msvc-debug",
            "configurePreset": "win-msvc-debug"
        },
        {
            "name": "win-msvc-release",
            "configurePreset": "win-msvc-release"
        },
        {
            "name": "win-clangcl-debug",
            "configurePreset": "win-clangcl-debug"
        },
        {
            "name": "win-clangcl-release",
            "configurePreset": "win-clangcl-release"
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release"
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release"
        },
        {
            "name": "mac-appleclang-debug",
            "configurePreset": "mac-appleclang-debug"
        },
        {
            "name": "win-msvc-shipping",
            "configurePreset": "win-msvc-shipping"
        },
        {
            "name": "win-clangcl-shipping",
            "configurePreset": "win-clangcl-shipping"
        },
        {
            "name": "linux-clang-shipping",
            "configurePreset": "linux-clang-shipping"
        },
        {
            "name": "linux-gcc-shipping",
            "configurePreset": "linux-gcc-shipping"
        }
    ],
    "testPresets": [
        {
            "name": "win-msvc-debug",
            "configurePreset": "win-msvc-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-msvc-release",
            "configurePreset": "win-msvc-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-clangcl-debug",
            "configurePreset": "win-clangcl-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-clangcl-release",
            "configurePreset": "win-clangcl-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "mac-appleclang-debug",
            "configurePreset": "mac-appleclang-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-msvc-shipping",
            "configurePreset": "win-msvc-shipping",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-clangcl-shipping",
            "configurePreset": "win-clangcl-shipping",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-clang-shipping",
            "configurePreset": "linux-clang-shipping",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-gcc-shipping",
            "configurePreset": "linux-gcc-shipping",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}
