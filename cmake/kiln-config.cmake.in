@PACKAGE_INIT@

# kiln package config.
#   find_package(kiln)                  -> kiln::core, kiln::runtime  (read-only side; ships in products)
#   find_package(kiln COMPONENTS cook)  -> additionally kiln::cook    (dev builds and tools)

include(CMakeFindDependencyMacro)
find_dependency(Threads)   # kiln::runtime's built-in thread pool

include("${CMAKE_CURRENT_LIST_DIR}/kilnRuntimeTargets.cmake")
set(kiln_runtime_FOUND TRUE)

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/kilnCookTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/kilnCookTargets.cmake")
    set(kiln_cook_FOUND TRUE)
else()
    set(kiln_cook_FOUND FALSE)
    if("cook" IN_LIST kiln_FIND_COMPONENTS)
        set(kiln_NOT_FOUND_MESSAGE
            "kiln component 'cook' was requested but this install carries only the read-only runtime (built with KILN_BUILD_COOK=OFF)")
    endif()
endif()

check_required_components(kiln)
